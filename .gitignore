# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# Operating System files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
.DS_Store
._*

# Logs & temporary caches
*.log
.pytest_cache/

# Explicitly ensure report PDF and sample benchmark assets are kept
!PROJECT_REPORT.pdf
!data/samples/*.png
!data/outputs/*.png
